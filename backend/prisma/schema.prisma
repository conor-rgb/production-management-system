generator client {
  provider = "prisma-client-js"
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("pms_sessions")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ContactType {
  CLIENT
  SUPPLIER
}

enum ContactSource {
  REFERRAL
  DIRECT
  SOCIAL
  PREVIOUS_JOB
  OTHER
}

enum BlackbookEntryType {
  PERSON
  COMPANY
  LOCATION
  TALENT
  SERVICE

  @@map("pms_blackbook_entry_type")
}

enum BlackbookCategory {
  CREW
  SERVICE
  LOCATION
  EQUIPMENT
  TALENT
  TRANSPORT
  POST
  OTHER

  @@map("pms_blackbook_category")
}

enum BlackbookLifecycleStatus {
  TARGET
  IN_TOUCH
  CLIENT
  PAST_CLIENT
  SUPPLIER
  PREFERRED_SUPPLIER
  DO_NOT_USE
  ARCHIVED

  @@map("pms_blackbook_lifecycle_status")
}

enum BlackbookOutreachStatus {
  NOT_CONTACTED
  CONTACTED
  REPLIED
  FOLLOW_UP
  NOT_INTERESTED
  CONVERTED
  ARCHIVED

  @@map("pms_blackbook_outreach_status")
}

enum BlackbookAddressType {
  WORK
  BILLING
  PERSONAL
  CUSTOM

  @@map("pms_blackbook_address_type")
}

enum BlackbookAddressSource {
  MANUAL
  GOOGLE_PLACES

  @@map("pms_blackbook_address_source")
}

// PmsJobType avoids conflict with legacy "JobType" enum in shared DB
enum PmsJobType {
  STILLS
  MOTION
  EVENTS
}

enum OppSource {
  EMAIL
  WHATSAPP
  DM
  REFERRAL
  OTHER
}

// Stage avoids conflict with legacy "OpportunityStage" enum in shared DB
enum Stage {
  ENQUIRY
  BIDDING
  QUOTED
  WON
  LOST
}

enum LostReason {
  COMPETITOR_WON
  BUDGET_PULLED
  NO_RESPONSE
  TIMING
  OTHER
}

enum ProductionStatus {
  PRE_PRO
  SHOOT
  POST
  WRAPPED
  PLANNING
  CONFIRMED
  IN_PRODUCTION
  WRAP
  DELIVERED
  INVOICED
  CLOSED
}

enum FreeAgentInvoiceStatus {
  NOT_RAISED
  DRAFT
  SENT
  VIEWED
  PAID
  OVERDUE
}

enum ProductionDateType {
  PPM
  RECCE
  FITTING
  BUILD
  MEETING
  SHOOT_DAY
  STRIKE
  POST_DELIVERY
  OTHER
}

enum ProductionDateStatus {
  PROPOSED
  OPTIONED
  CONFIRMED
  RELEASED
  CANCELLED

  @@map("pms_production_date_status")
}

enum CrewStatus {
  REQUESTED
  FIRST_OPTION
  SECOND_OPTION
  CONFIRMED
  RELEASED
}

enum CrewItineraryStatus {
  DRAFT
  READY
  SENT
}

enum CrewItineraryItemType {
  CAR
  TRAIN
  FLIGHT
  HOTEL
  EVENT
}

enum ActivityEntityType {
  PRODUCTION
  OPPORTUNITY
}

enum BudgetStatus {
  DRAFT
  SENT
  CONFIRMED
  IN_PRODUCTION
  WRAPPED

  @@map("pms_budget_status")
}

enum RevisionStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  SUPERSEDED

  @@map("pms_revision_status")
}

enum SubCostStatus {
  PENDING
  AGREED
  INVOICED
  PAID

  @@map("pms_sub_cost_status")
}

enum SubCostLineType {
  PO
  BILL
  PENDING_RECEIPT
  RECEIPT
  IN_HOUSE

  @@map("pms_sub_cost_line_type")
}

enum PurchaseOrderStatus {
  ISSUED
  DRAFT
  SENT
  ACCEPTED
  PART_BILLED
  BILLED
  PAID
  CANCELLED

  @@map("pms_purchase_order_status")
}

enum StillStatus {
  UPLOADED
  SHORTLIST
  CLIENT_SELECT
  TO_RETOUCH
  RETOUCHING
  CHANGES_REQUESTED
  APPROVED
  DELIVERED
  REJECTED

  @@map("pms_still_status")
}

enum StillAnnotationVisibility {
  INTERNAL
  CLIENT

  @@map("pms_still_annotation_visibility")
}

enum StillSourceAssetType {
  RAW
  TIFF
  EIP
  PSD
  DRIVE_FOLDER
  OTHER

  @@map("pms_still_source_asset_type")
}

enum StillShareRole {
  CLIENT
  RETOUCHER

  @@map("pms_still_share_role")
}

enum StillActivityAction {
  VIEWED
  STATUS_CHANGED
  RATING_CHANGED
  COMMENTED
  NOTE_RESOLVED
  REVIEW_SUBMITTED
  VERSION_UPLOADED

  @@map("pms_still_activity_action")
}

enum AdvanceCalcType {
  PERCENT_OF_TOTAL
  PERCENT_OF_PRODUCTION
  FIXED_AMOUNT

  @@map("pms_advance_calc_type")
}

enum ReceiptCaptureStatus {
  PENDING
  PARSING
  PARSED
  ASSIGNED
  FAILED

  @@map("pms_receipt_capture_status")
}

enum EmailProvider {
  GOOGLE
  IMAP
}

enum CalendarEventType {
  SHOOT_DAY
  PPM
  RECCE
  FITTING
  MEETING
  POST_DELIVERY
  FOLLOW_UP
  GOOGLE_SYNC
  STANDALONE
  OTHER

  @@map("pms_calendar_event_type")
}

enum ProjectActionType {
  TASK
  DEADLINE
  EVENT
  MEETING
  TRAVEL
  SHOOT
  REMINDER

  @@map("pms_project_action_type")
}

enum ProjectActionStatus {
  TODO
  IN_PROGRESS
  WAITING
  DONE
  BLOCKED
  CANCELLED

  @@map("pms_project_action_status")
}

enum ProjectActionVisibility {
  INTERNAL
  CLIENT

  @@map("pms_project_action_visibility")
}

enum ProductionWorkbookSheetType {
  DASHBOARD
  SCOPE_DATES
  ROLE_PLAN
  OPTIONS_HOLDS
  CONFIRMED_TEAM
  LOCATIONS
  ARTISTS_TALENT
  CATERING
  TODO
  TIMELINE
  RUN_OF_SHOW
  CREW
  HOLDS
  TRAVEL
  HOTELS
  CARS
  EQUIPMENT
  DELIVERIES
  TASKS_CHASES
  FILES_COMMS

  @@map("pms_production_workbook_sheet_type")
}

enum ProductionWorkbookRowStatus {
  TODO
  IN_PROGRESS
  WAITING
  BLOCKED
  DONE
  CANCELLED
  REQUESTED
  FIRST_OPTION
  SECOND_OPTION
  CONFIRMED
  RELEASED
  PARKED
  NEEDS_CHASE
  SENT
  READY
  INTERNAL

  @@map("pms_production_workbook_row_status")
}

// ─── Settings ────────────────────────────────────────────────────────────────

model Settings {
  id                    String   @id @default(cuid())
  email                 String   @unique
  password              String
  jobCodeYear           Int      @default(2026)
  jobCodeSequence       Int      @default(46)
  defaultEmailSignature String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("pms_settings")
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Company {
  id            String        @id @default(cuid())
  name          String
  website       String?
  address       String?
  notes         String?
  contacts      Contact[]
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("pms_companies")
}

model Contact {
  id               String                 @id @default(cuid())
  firstName        String
  lastName         String?
  email            String?
  phone            String?
  companyId        String?
  company          Company?               @relation(fields: [companyId], references: [id])
  jobTitle         String?
  type             ContactType            @default(CLIENT)
  source           ContactSource          @default(OTHER)
  tags             String[]               @default([])
  lastContactedAt  DateTime?
  notes            String?
  opportunities    Opportunity[]
  crewMembers      CrewMember[]
  productionDates  ProductionDatePerson[]
  emailThreads     EmailThread[]
  emailDrafts      EmailDraft[]
  blackbookEntries BlackbookEntry[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@map("pms_contacts")
}

model BlackbookConfigCategory {
  id         String                @id @default(uuid())
  name       String
  slug       String                @unique
  broadType  BlackbookCategory     @default(OTHER)
  color      String                @default("#1a1a1f")
  order      Int                   @default(0)
  coreFields Json                  @default("[]")
  types      BlackbookConfigType[]
  entries    BlackbookEntry[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@map("pms_blackbook_config_categories")
}

model BlackbookConfigType {
  id         String                  @id @default(uuid())
  categoryId String
  name       String
  slug       String
  order      Int                     @default(0)
  category   BlackbookConfigCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([categoryId, slug])
  @@map("pms_blackbook_config_types")
}

model BlackbookTargetList {
  id          String                     @id @default(uuid())
  name        String
  description String?
  isArchived  Boolean                    @default(false)
  entries     BlackbookTargetListEntry[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@map("pms_blackbook_target_lists")
}

model BlackbookTargetListEntry {
  id             String                  @id @default(uuid())
  listId         String
  entryId        String
  status         BlackbookOutreachStatus @default(NOT_CONTACTED)
  notes          String?
  nextFollowUpAt DateTime?               @db.Date
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  list  BlackbookTargetList @relation(fields: [listId], references: [id], onDelete: Cascade)
  entry BlackbookEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([listId, entryId])
  @@index([entryId])
  @@map("pms_blackbook_target_list_entries")
}

model BlackbookEntry {
  id                            String                   @id @default(uuid())
  entryType                     BlackbookEntryType       @default(PERSON)
  category                      BlackbookCategory        @default(OTHER)
  categoryConfigId              String?
  typeIds                       String[]                 @default([])
  lifecycleStatus               BlackbookLifecycleStatus @default(IN_TOUCH)
  companyEntryId                String?
  displayName                   String
  firstName                     String?
  lastName                      String?
  companyName                   String?
  jobTitle                      String?
  email                         String?
  phone                         String?
  website                       String?
  tags                          String[]                 @default([])
  notes                         String?
  supplierOnboarding            Json?
  supplierOnboardingCompletedAt DateTime?
  supplierBillingEmail          String?
  supplierBankAccountName       String?
  supplierBankAccountNumber     String?
  supplierBankSortCode          String?
  supplierBankIban              String?
  supplierBankSwift             String?
  supplierVatNumber             String?

  // Commercial defaults
  defaultRate Float?
  rateUnit    String?
  currency    String  @default("GBP")

  // Person-level catering requirements. Production-specific overrides can be
  // added later without losing the reusable blackbook baseline.
  dietaryNotes String?
  dietaryFlags String[] @default([])
  allergens    String[] @default([])

  // Structured location/company address fields for filtering and deck output.
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postcode     String?
  country      String?
  locationType String?
  latitude     Float?
  longitude    Float?

  // Location/studio technical fields seen in the historical decks.
  daylight        Boolean?
  blackout        Boolean?
  areaSqm         Float?
  shootingAreaSqm Float?
  ceilingHeight   String?
  accessNotes     String?
  parkingNotes    String?
  travelNotes     String?
  facilities      String?

  // Talent/model fields from casting decks.
  ukAgency     String?
  frAgency     String?
  bookUrl      String?
  socialUrl    String?
  polasUrl     String?
  selfTapeUrl  String?
  modelsComUrl String?
  height       String?
  eyes         String?
  hair         String?
  bust         String?
  waist        String?
  hips         String?
  shoe         String?

  addresses        BlackbookAddress[]
  optionCandidates OptionCandidate[]
  purchaseOrders   PurchaseOrderGroup[]
  projectActions   ProjectAction[]
  crewMembers      CrewMember[]
  contactId        String?
  contact          Contact?                   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  categoryConfig   BlackbookConfigCategory?   @relation(fields: [categoryConfigId], references: [id], onDelete: SetNull)
  companyEntry     BlackbookEntry?            @relation("BlackbookCompanyPeople", fields: [companyEntryId], references: [id], onDelete: SetNull)
  people           BlackbookEntry[]           @relation("BlackbookCompanyPeople")
  targetLists      BlackbookTargetListEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryType, category])
  @@index([categoryConfigId])
  @@index([lifecycleStatus])
  @@index([companyEntryId])
  @@index([contactId])
  @@index([displayName])
  @@index([email])
  @@map("pms_blackbook_entries")
}

model BlackbookAddress {
  id               String                 @id @default(uuid())
  entryId          String
  type             BlackbookAddressType   @default(WORK)
  label            String?
  isDefaultBilling Boolean                @default(false)
  source           BlackbookAddressSource @default(MANUAL)
  placeId          String?
  placeName        String?
  formattedAddress String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  region           String?
  postcode         String?
  country          String?
  latitude         Float?
  longitude        Float?
  website          String?
  phone            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  entry            BlackbookEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  optionCandidates OptionCandidate[]

  @@index([entryId])
  @@map("pms_blackbook_addresses")
}

// ─── Opportunities ────────────────────────────────────────────────────────────

model Opportunity {
  id             String            @id @default(cuid())
  title          String
  clientName     String?
  brand          String?
  jobType        PmsJobType?
  source         OppSource         @default(OTHER)
  contactId      String?
  contact        Contact?          @relation(fields: [contactId], references: [id])
  companyId      String?
  company        Company?          @relation(fields: [companyId], references: [id])
  description    String?
  value          Decimal?          @db.Decimal(12, 2)
  stage          Stage             @default(ENQUIRY)
  followUpDate   DateTime?         @db.Date
  lostReason     LostReason?
  lostNote       String?
  dateReceived   DateTime?         @db.Date
  notes          String?
  productions    Production[]
  budgets        Budget[]
  activityNotes  OpportunityNote[]
  tasks          OpportunityTask[]
  emailThreads   EmailThread[]
  emailDrafts    EmailDraft[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("pms_opportunities")
}

model OpportunityNote {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("pms_opportunity_notes")
}

model OpportunityTask {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  body          String
  completed     Boolean     @default(false)
  completedAt   DateTime?
  dueDate       DateTime?   @db.Date
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("pms_opportunity_tasks")
}

// ─── Productions ─────────────────────────────────────────────────────────────

model Production {
  id                     String                 @id @default(cuid())
  title                  String
  clientName             String?
  brand                  String?
  jobType                PmsJobType?
  jobCode                String?                @unique
  description            String?
  status                 ProductionStatus       @default(PRE_PRO)
  value                  Decimal?               @db.Decimal(12, 2)
  freeAgentInvoiceStatus FreeAgentInvoiceStatus @default(NOT_RAISED)
  notes                  String?
  driveFolderId          String?                @unique
  driveFolderName        String?
  workspaceVersion       Int @default(1)
  creationRequestId       String? @unique
  creationHash            String?
  starterTemplate         String?
  driveSetupStatus        String @default("NOT_REQUESTED")
  driveSetupError         String?
  driveFolders            ProjectDriveFolder[]
  estimateApprovals       ProjectEstimateApproval[]
  storagePath            String?
  lastPoSequence         Int                    @default(0)
  actualSpend            Float                  @default(0)
  variance               Float                  @default(0)
  opportunityId          String?
  opportunity            Opportunity?           @relation(fields: [opportunityId], references: [id])
  contactId              String?
  dates                  ProductionDate[]
  crewMembers            CrewMember[]
  crewItineraries         CrewItinerary[]
  budgets                Budget[]
  jobFiles               JobFile[]
  emailThreads           EmailThread[]
  emailDrafts            EmailDraft[]
  receiptCaptures        ReceiptCapture[]
  calendarEvents         CalendarEvent[]
  projectWorkstreams     ProjectWorkstream[]
  projectActions         ProjectAction[]
  optionsBoard           OptionsBoard?
  optionGroups           OptionGroup[]
  optionRequirements     OptionRequirement[]
  optionCandidates       OptionCandidate[]
  purchaseOrders         PurchaseOrderGroup[]
  productionSkus         ProductionSku[]
  stillFolders           StillFolder[]
  stillImages            StillImage[]
  stillShareLinks        StillShareLink[]
  stillImageActivities   StillImageActivity[]
  financeLedger          ProjectFinanceLedger?
  workbook               ProductionWorkbook?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@map("pms_productions")
}

model ProductionWorkbook {
  id           String                    @id @default(uuid())
  productionId String                    @unique
  title        String
  metadata     Json                      @default("{}")
  sheets       ProductionSheet[]
  rows         ProductionSheetRow[]
  cells        ProductionSheetCell[]
  production   Production                @relation(fields: [productionId], references: [id], onDelete: Cascade)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  @@map("pms_production_workbooks")
}

model ProductionSheet {
  id         String                      @id @default(uuid())
  workbookId String
  type       ProductionWorkbookSheetType
  title      String
  order      Int                         @default(0)
  config     Json                        @default("{}")
  workbook   ProductionWorkbook          @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  rows       ProductionSheetRow[]
  cells      ProductionSheetCell[]
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@unique([workbookId, type])
  @@index([workbookId, order])
  @@map("pms_production_sheets")
}

model ProductionSheetRow {
  id               String                       @id @default(uuid())
  workbookId       String
  sheetId          String
  sheetType        ProductionWorkbookSheetType
  order            Int                          @default(0)
  status           ProductionWorkbookRowStatus?
  title            String?
  date             DateTime?                    @db.Date
  startAt          DateTime?
  endAt            DateTime?
  workstream       String?
  owner            String?
  location         String?
  notes            String?
  data             Json                         @default("{}")
  sourceEntityType String?
  sourceEntityId   String?
  workbook         ProductionWorkbook           @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  sheet            ProductionSheet              @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  cells            ProductionSheetCell[]
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([workbookId, sheetType, sourceEntityType, sourceEntityId])
  @@index([workbookId, sheetType, order])
  @@index([sheetId, order])
  @@index([sourceEntityType, sourceEntityId])
  @@map("pms_production_sheet_rows")
}

model ProductionSheetCell {
  id         String             @id @default(uuid())
  workbookId String
  sheetId    String
  rowId      String
  key        String
  value      Json?
  updatedBy  String?
  workbook   ProductionWorkbook @relation(fields: [workbookId], references: [id], onDelete: Cascade)
  sheet      ProductionSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  row        ProductionSheetRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@unique([rowId, key])
  @@index([workbookId])
  @@index([sheetId])
  @@map("pms_production_sheet_cells")
}

model OptionsBoard {
  id           String            @id @default(uuid())
  productionId String            @unique
  title        String            @default("Options")
  categories   OptionsCategory[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@map("pms_options_boards")
}

model OptionGroup {
  id                String                @id @default(uuid())
  productionId      String
  workstreamId      String?
  name              String
  type              OptionRequirementType @default(OTHER)
  order             Int                   @default(0)
  hiddenFromCrewList Boolean               @default(false)
  requirements      OptionRequirement[]
  candidates        OptionCandidate[]
  columns           OptionColumn[]
  savedViews        OptionSavedView[]
  deckTemplate      OptionDeckTemplate?
  legacyWorkstreams ProjectWorkstream[]   @relation("LegacyWorkstreamOptionGroup")
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  production Production         @relation(fields: [productionId], references: [id], onDelete: Cascade)
  workstream ProjectWorkstream? @relation("WorkstreamOptionGroups", fields: [workstreamId], references: [id], onDelete: SetNull)

  @@index([productionId, order])
  @@index([workstreamId])
  @@map("pms_option_groups")
}

model OptionDeckTemplate {
  id        String   @id @default(uuid())
  groupId   String   @unique
  name      String   @default("Options deck")
  blocks    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("pms_option_deck_templates")
}

model OptionSavedView {
  id            String   @id @default(uuid())
  groupId       String
  name          String
  icon          String   @default("▦")
  baseView      String   @default("grid")
  filters       Json?
  sortKey       String   @default("manual")
  sortDirection String   @default("asc")
  columnState   Json?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, order])
  @@map("pms_option_saved_views")
}

model OptionRequirement {
  id             String                 @id @default(uuid())
  productionId   String
  groupId        String
  name           String
  displayLabel   String
  type           OptionRequirementType  @default(OTHER)
  slotNumber     Int                    @default(1)
  activeState    OptionRequirementState @default(ACTIVE)
  notes          String?
  order          Int                    @default(0)
  dateNeeds      RequirementDateNeed[]
  assignments    OptionSlotAssignment[]
  projectActions ProjectAction[]
  crewMembers    CrewMember[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  production Production  @relation(fields: [productionId], references: [id], onDelete: Cascade)
  group      OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([productionId, order])
  @@index([groupId])
  @@map("pms_option_requirements")
}

model RequirementDateNeed {
  id            String   @id @default(uuid())
  requirementId String
  dateId        String
  isRequired    Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirement OptionRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  date        ProductionDate    @relation(fields: [dateId], references: [id], onDelete: Cascade)

  @@unique([requirementId, dateId])
  @@index([dateId])
  @@map("pms_requirement_date_needs")
}

model OptionCandidate {
  id                String                      @id @default(uuid())
  productionId      String
  groupId           String
  blackbookEntryId  String?
  selectedAddressId String?
  name              String
  subtitle          String?
  website           String?
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  bookUrl           String?
  socialUrl         String?
  modelsComUrl      String?
  pdfUrl            String?
  pdfFilename       String?
  pdfStoredPath     String?
  pdfSizeBytes      Int?
  pdfPublicToken    String?                     @unique
  addressLine1      String?
  addressLine2      String?
  city              String?
  region            String?
