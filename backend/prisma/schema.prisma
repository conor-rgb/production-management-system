generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ContactType {
  CLIENT
  SUPPLIER
}

enum ContactSource {
  REFERRAL
  DIRECT
  SOCIAL
  PREVIOUS_JOB
  OTHER
}

// PmsJobType avoids conflict with legacy "JobType" enum in shared DB
enum PmsJobType {
  STILLS
  MOTION
  EVENTS
}

enum OppSource {
  EMAIL
  WHATSAPP
  DM
  REFERRAL
  OTHER
}

// Stage avoids conflict with legacy "OpportunityStage" enum in shared DB
enum Stage {
  ENQUIRY
  BIDDING
  QUOTED
  WON
  LOST
}

enum LostReason {
  COMPETITOR_WON
  BUDGET_PULLED
  NO_RESPONSE
  TIMING
  OTHER
}

enum ProductionStatus {
  PRE_PRO
  SHOOT
  POST
  WRAPPED
  PLANNING
  CONFIRMED
  IN_PRODUCTION
  WRAP
  DELIVERED
  INVOICED
  CLOSED
}

enum FreeAgentInvoiceStatus {
  NOT_RAISED
  DRAFT
  SENT
  VIEWED
  PAID
  OVERDUE
}

enum ProductionDateType {
  PPM
  RECCE
  FITTING
  MEETING
  SHOOT_DAY
  POST_DELIVERY
  OTHER
}

enum CrewStatus {
  REQUESTED
  FIRST_OPTION
  SECOND_OPTION
  CONFIRMED
  RELEASED
}

enum ActivityEntityType {
  PRODUCTION
  OPPORTUNITY
}

enum BudgetRevisionStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  SUPERSEDED
}

enum InvoiceStatus {
  PENDING
  PAID
}

enum PurchaseOrderStatus {
  OPEN
  INVOICED
  PAID
}

enum ReceiptCaptureStatus {
  PENDING
  PARSING
  PARSED
  ASSIGNED
  FAILED

  @@map("pms_receipt_capture_status")
}

enum EmailProvider {
  GOOGLE
  IMAP
}

enum CalendarEventType {
  SHOOT_DAY
  PPM
  RECCE
  FITTING
  MEETING
  POST_DELIVERY
  FOLLOW_UP
  GOOGLE_SYNC
  STANDALONE
  OTHER

  @@map("pms_calendar_event_type")
}

// ─── Settings ────────────────────────────────────────────────────────────────

model Settings {
  id                    String   @id @default(cuid())
  email                 String   @unique
  password              String
  jobCodeYear           Int      @default(2026)
  jobCodeSequence       Int      @default(46)
  defaultEmailSignature String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("pms_settings")
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Company {
  id            String        @id @default(cuid())
  name          String
  website       String?
  address       String?
  notes         String?
  contacts      Contact[]
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("pms_companies")
}

model Contact {
  id              String                 @id @default(cuid())
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  companyId       String?
  company         Company?               @relation(fields: [companyId], references: [id])
  jobTitle        String?
  type            ContactType            @default(CLIENT)
  source          ContactSource          @default(OTHER)
  tags            String[]               @default([])
  lastContactedAt DateTime?
  notes           String?
  opportunities   Opportunity[]
  crewMembers     CrewMember[]
  productionDates ProductionDatePerson[]
  emailThreads    EmailThread[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@map("pms_contacts")
}

// ─── Opportunities ────────────────────────────────────────────────────────────

model Opportunity {
  id            String            @id @default(cuid())
  title         String
  clientName    String?
  brand         String?
  jobType       PmsJobType?
  source        OppSource         @default(OTHER)
  contactId     String?
  contact       Contact?          @relation(fields: [contactId], references: [id])
  companyId     String?
  company       Company?          @relation(fields: [companyId], references: [id])
  description   String?
  value         Decimal?          @db.Decimal(12, 2)
  stage         Stage             @default(ENQUIRY)
  followUpDate  DateTime?         @db.Date
  lostReason    LostReason?
  lostNote      String?
  dateReceived  DateTime?         @db.Date
  notes         String?
  productions   Production[]
  budgets       Budget[]
  activityNotes OpportunityNote[]
  tasks         OpportunityTask[]
  emailThreads  EmailThread[]
  calendarEvents CalendarEvent[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("pms_opportunities")
}

model OpportunityNote {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("pms_opportunity_notes")
}

model OpportunityTask {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  body          String
  completed     Boolean     @default(false)
  completedAt   DateTime?
  dueDate       DateTime?   @db.Date
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("pms_opportunity_tasks")
}

// ─── Productions ─────────────────────────────────────────────────────────────

model Production {
  id                     String                 @id @default(cuid())
  title                  String
  clientName             String?
  brand                  String?
  jobType                PmsJobType?
  jobCode                String?                @unique
  description            String?
  status                 ProductionStatus       @default(PRE_PRO)
  value                  Decimal?               @db.Decimal(12, 2)
  freeAgentInvoiceStatus FreeAgentInvoiceStatus @default(NOT_RAISED)
  notes                  String?
  storagePath            String?
  lastPoSequence         Int                    @default(0)
  opportunityId          String?
  opportunity            Opportunity?           @relation(fields: [opportunityId], references: [id])
  contactId              String?
  dates                  ProductionDate[]
  crewMembers            CrewMember[]
  budgets                Budget[]
  jobFiles               JobFile[]
  purchaseOrders         PurchaseOrder[]
  emailThreads           EmailThread[]
  receiptCaptures        ReceiptCapture[]
  calendarEvents         CalendarEvent[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@map("pms_productions")
}

model ProductionDate {
  id           String                 @id @default(cuid())
  productionId String
  production   Production             @relation(fields: [productionId], references: [id], onDelete: Cascade)
  dateType     ProductionDateType     @default(OTHER)
  date         DateTime               @db.Date
  time         String?
  location     String?
  zoomLink     String?
  notes        String?
  label        String?
  people       ProductionDatePerson[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@map("pms_production_dates")
}

model ProductionDatePerson {
  id               String         @id @default(cuid())
  productionDateId String
  productionDate   ProductionDate @relation(fields: [productionDateId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([productionDateId, contactId])
  @@map("pms_production_date_people")
}

model CalendarEvent {
  id                    String            @id @default(uuid())
  title                 String
  startDate             DateTime
  endDate               DateTime
  isAllDay              Boolean           @default(false)
  location              String?
  zoomLink              String?
  notes                 String?
  color                 String?
  eventType             CalendarEventType @default(STANDALONE)
  productionId          String?
  productionDateId      String?
  opportunityId         String?
  contactIds            String[]          @default([])
  googleCalendarEventId String?
  googleCalendarId      String?
  syncedFromGoogle      Boolean           @default(false)
  lastSyncedAt          DateTime?
  production            Production?       @relation(fields: [productionId], references: [id], onDelete: SetNull)
  opportunity           Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([startDate])
  @@index([endDate])
  @@index([productionId])
  @@index([productionDateId])
  @@index([opportunityId])
  @@index([googleCalendarEventId])
  @@map("pms_calendar_events")
}

// ─── Crew ─────────────────────────────────────────────────────────────────────

model CrewRole {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  crewMembers CrewMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("pms_crew_roles")
}

model CrewMember {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?   @relation(fields: [contactId], references: [id])
  roleId       String?
  role         CrewRole?  @relation(fields: [roleId], references: [id])
  name         String
  email        String?
  phone        String?
  status       CrewStatus @default(REQUESTED)
  dayRate      Decimal?   @db.Decimal(10, 2)
  numberOfDays Decimal    @default(1) @db.Decimal(6, 2)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("pms_crew_members")
}

// ─── Budgets ──────────────────────────────────────────────────────────────────

model Budget {
  id                String           @id @default(cuid())
  productionId      String?
  production        Production?      @relation(fields: [productionId], references: [id], onDelete: Cascade)
  opportunityId     String?
  opportunity       Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  currentRevisionId String?          @unique
  currentRevision   BudgetRevision?  @relation("CurrentBudgetRevision", fields: [currentRevisionId], references: [id])
  revisions         BudgetRevision[] @relation("BudgetRevisions")
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@map("pms_budgets")
}

model BudgetRevision {
  id                   String               @id @default(cuid())
  budgetId             String
  budget               Budget               @relation("BudgetRevisions", fields: [budgetId], references: [id], onDelete: Cascade)
  currentForBudget     Budget?              @relation("CurrentBudgetRevision")
  revisionNumber       Int
  label                String
  status               BudgetRevisionStatus @default(DRAFT)
  version              Int                  @default(1)
  productionFeePercent Float                @default(10)
  notes                String?
  sections             BudgetSection[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([budgetId, revisionNumber])
  @@map("pms_budget_revisions")
}

model BudgetSection {
  id         String           @id @default(cuid())
  revisionId String
  revision   BudgetRevision   @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  code       String
  name       String
  order      Int              @default(0)
  lineItems  BudgetLineItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([revisionId, code])
  @@map("pms_budget_sections")
}

model BudgetLineItem {
  id               String            @id @default(cuid())
  sectionId        String
  section          BudgetSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  lineCode         String
  description      String
  privateMemo      String?
  publicMemo       String?
  internalUnitCost Float             @default(0)
  clientUnitCost   Float             @default(0)
  quantity         Float             @default(1)
  daysUnits        Float             @default(1)
  unitLabel        String            @default("Days")
  agencyMarkup     Float             @default(0)
  internalSubtotal Float             @default(0)
  clientSubtotal   Float             @default(0)
  marginAmount     Float             @default(0)
  marginPercent    Float             @default(0)
  actualCost       Float             @default(0)
  variance         Float             @default(0)
  isClosed         Boolean           @default(false)
  isTaxable        Boolean           @default(false)
  hasPW            Boolean           @default(false)
  hasHealthSafety  Boolean           @default(false)
  baseHours        Float?
  overtime15x      Float?
  overtime2x       Float?
  catalogItemId    String?
  catalogItem      CatalogItem?      @relation(fields: [catalogItemId], references: [id])
  order            Int               @default(0)
  invoices         LineItemInvoice[]
  purchaseOrders   PurchaseOrder[]
  jobFiles         JobFile[]
  receiptCaptures  ReceiptCapture[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("pms_budget_line_items")
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  lineItemId    String
  lineItem      BudgetLineItem      @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  productionId  String
  production    Production          @relation(fields: [productionId], references: [id], onDelete: Cascade)
  poNumber      String
  supplierName  String
  description   String?
  agreedAmount  Float
  status        PurchaseOrderStatus @default(OPEN)
  dateRaised    DateTime            @default(now()) @db.Date
  invoiceNumber String?
  invoiceDate   DateTime?           @db.Date
  invoiceFileId String?
  invoiceFile   JobFile?            @relation(fields: [invoiceFileId], references: [id])
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([productionId, poNumber])
  @@index([lineItemId])
  @@index([productionId])
  @@map("pms_purchase_orders")
}

model LineItemInvoice {
  id            String         @id @default(cuid())
  lineItemId    String
  lineItem      BudgetLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  supplierName  String
  invoiceNumber String?
  amount        Float
  dateReceived  DateTime?      @db.Date
  status        InvoiceStatus  @default(PENDING)
  jobFileId     String?
  jobFile       JobFile?       @relation(fields: [jobFileId], references: [id])
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("pms_line_item_invoices")
}

model CatalogItem {
  id                      String             @id @default(cuid())
  section                 String
  description             String
  defaultInternalUnitCost Float              @default(0)
  defaultClientUnitCost   Float              @default(0)
  defaultUnitLabel        String             @default("Days")
  defaultQuantity         Float              @default(1)
  defaultDaysUnits        Float              @default(1)
  defaultAgencyMarkup     Float              @default(0)
  notes                   String?
  isActive                Boolean            @default(true)
  order                   Int                @default(0)
  lineItems               BudgetLineItem[]
  groupItems              CatalogGroupItem[]
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([section, isActive])
  @@map("pms_catalog_items")
}

model CatalogGroup {
  id          String             @id @default(cuid())
  name        String
  description String?
  items       CatalogGroupItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("pms_catalog_groups")
}

model CatalogGroupItem {
  id            String       @id @default(cuid())
  groupId       String
  group         CatalogGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  catalogItemId String
  catalogItem   CatalogItem  @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)
  order         Int          @default(0)

  @@unique([groupId, catalogItemId])
  @@map("pms_catalog_group_items")
}

// ─── Files ────────────────────────────────────────────────────────────────────

model JobFile {
  id                         String            @id @default(cuid())
  productionId               String?
  production                 Production?       @relation(fields: [productionId], references: [id], onDelete: SetNull)
  folder                     String
  originalFilename           String
  storedFilename             String
  mimeType                   String
  sizeBytes                  Int
  uploadedAt                 DateTime          @default(now())
  linkedBudgetLineId         String?
  linkedBudgetLine           BudgetLineItem?   @relation(fields: [linkedBudgetLineId], references: [id])
  isReceipt                  Boolean           @default(false)
  receiptVendor              String?
  receiptAmount              Int?
  receiptDate                DateTime?         @db.Date
  notes                      String?
  sourceEmailThreadId        String?
  sourceEmailThread          EmailThread?      @relation("JobFileSourceEmailThread", fields: [sourceEmailThreadId], references: [id], onDelete: SetNull)
  sourceEmailMessageId       String?
  sourceEmailMessage         EmailMessage?     @relation("JobFileSourceEmailMessage", fields: [sourceEmailMessageId], references: [id], onDelete: SetNull)
  sourceEmailAttachmentIndex Int?
  sourceEmailFilename        String?
  invoices                   LineItemInvoice[]
  purchaseOrderInvoices      PurchaseOrder[]
  receiptCaptures            ReceiptCapture[]

  @@index([productionId, folder])
  @@index([originalFilename])
  @@index([sourceEmailThreadId])
  @@index([sourceEmailMessageId, sourceEmailAttachmentIndex])
  @@map("pms_job_files")
}

model ReceiptCapture {
  id                    String               @id @default(uuid())
  status                ReceiptCaptureStatus @default(PENDING)
  originalFilename      String
  storedFilename        String
  mimeType              String
  sizeBytes             Int
  storedPath            String
  parsedVendor          String?
  parsedAmount          Int?
  parsedAmountGross     Int?
  parsedAmountNet       Int?
  parsedVatAmount       Int?
  parsedVatRate         Float?
  parsedDate            DateTime?            @db.Date
  parsedCurrency        String               @default("GBP")
  parsedDescription     String?
  parsedAicpSection     String?
  parsedAicpSectionName String?
  parseConfidence       String?
  parseRawText          String?
  parsedAt              DateTime?
  productionId          String?
  production            Production?          @relation(fields: [productionId], references: [id], onDelete: SetNull)
  lineItemId            String?
  lineItem              BudgetLineItem?      @relation(fields: [lineItemId], references: [id], onDelete: SetNull)
  jobFileId             String?
  jobFile               JobFile?             @relation(fields: [jobFileId], references: [id], onDelete: SetNull)
  assignedAt            DateTime?
  capturedOffline       Boolean              @default(false)
  syncedAt              DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status])
  @@index([productionId])
  @@index([lineItemId])
  @@index([jobFileId])
  @@map("pms_receipt_captures")
}

// ─── Email ────────────────────────────────────────────────────────────────────

model EmailAccount {
  id                    String        @id @default(uuid())
  label                 String
  emailAddress          String
  provider              EmailProvider
  imapHost              String?
  imapPort              Int?
  smtpHost              String?
  smtpPort              Int?
  username              String?
  encryptedPassword     String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiry           DateTime?
  isActive              Boolean       @default(true)
  isPrimary             Boolean       @default(false)
  lastSyncedAt          DateTime?
  threads               EmailThread[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("pms_email_accounts")
}

model EmailThread {
  id                  String         @id @default(uuid())
  accountId           String?
  account             EmailAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  externalThreadId    String         @default(uuid())
  subject             String
  participants        String[]       @default([])
  lastMessageAt       DateTime       @default(now())
  isRead              Boolean        @default(false)
  isFlagged           Boolean        @default(false)
  isArchived          Boolean        @default(false)
  linkedContactId     String?
  linkedContact       Contact?       @relation(fields: [linkedContactId], references: [id], onDelete: SetNull)
  linkedOpportunityId String?
  linkedOpportunity   Opportunity?   @relation(fields: [linkedOpportunityId], references: [id], onDelete: SetNull)
  linkedProductionId  String?
  linkedProduction    Production?    @relation(fields: [linkedProductionId], references: [id], onDelete: SetNull)
  messages            EmailMessage[]
  sourceJobFiles      JobFile[]      @relation("JobFileSourceEmailThread")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([accountId, externalThreadId])
  @@index([lastMessageAt])
  @@index([linkedContactId])
  @@index([linkedOpportunityId])
  @@index([linkedProductionId])
  @@map("pms_email_threads")
}

model ActivityNote {
  id         String             @id @default(cuid())
  entityType ActivityEntityType
  entityId   String
  body       String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([entityType, entityId])
  @@map("pms_activity_notes")
}

model ActivityTask {
  id          String             @id @default(cuid())
  entityType  ActivityEntityType
  entityId    String
  body        String
  completed   Boolean            @default(false)
  completedAt DateTime?
  dueDate     DateTime?          @db.Date
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([entityType, entityId])
  @@map("pms_activity_tasks")
}

model EmailMessage {
  id                String      @id @default(uuid())
  threadId          String
  thread            EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  externalMessageId String      @unique
  fromAddress       String
  fromName          String?
  toAddresses       String[]    @default([])
  ccAddresses       String[]    @default([])
  bccAddresses      String[]    @default([])
  subject           String
  bodyHtml          String      @default("")
  bodyText          String      @default("")
  sentAt            DateTime
  isFromMe          Boolean     @default(false)
  hasAttachments    Boolean     @default(false)
  attachments       Json        @default("[]")
  imapMailbox       String?
  imapUid           Int?
  sourceJobFiles    JobFile[]   @relation("JobFileSourceEmailMessage")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([threadId, sentAt])
  @@index([imapMailbox, imapUid])
  @@map("pms_email_messages")
}

model EmailTemplate {
  id         String   @id @default(uuid())
  name       String
  subject    String
  bodyHtml   String
  defaultCc  String?
  defaultBcc String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("pms_email_templates")
}
