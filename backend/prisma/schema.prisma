// Independent operational ledger. Estimate revisions are never mutated here.
model ProjectFinanceLedger {
  productionId String @id
  currency String
  production Production @relation(fields: [productionId], references: [id], onDelete: Restrict)
  costs ProjectFinanceCost[]
  clientInvoices ProjectClientInvoice[]
  invoices ProjectSupplierInvoice[]
  operations ProjectFinanceOperation[]
  createdAt DateTime @default(now())
  @@map("pms_project_finance_ledgers")
}

model ProjectFinanceCost {
  activePurchaseOrderId String?
  activePurchaseOrder PurchaseOrderGroup? @relation("ActiveFinancePo", fields: [activePurchaseOrderId], references: [id], onDelete: Restrict)
  purchaseOrderLines ProjectPurchaseOrderLine[]

  commitmentStatus String @default("COMMITTED")
  estimateLineKey String?
  id String @id @default(uuid())
  productionId String
  ledger ProjectFinanceLedger @relation(fields: [productionId], references: [productionId], onDelete: Restrict)
  description String
  supplier String
  supplierKey String
  committedMinor Int
  remainingMinor Int?
  version Int @default(1)
  allocations ProjectInvoiceAllocation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([productionId])
  @@unique([productionId, estimateLineKey])
  @@map("pms_project_finance_costs")
}

