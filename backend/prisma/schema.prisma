generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ContactType {
  CLIENT
  SUPPLIER
}

enum ContactSource {
  REFERRAL
  DIRECT
  SOCIAL
  PREVIOUS_JOB
  OTHER
}

// PmsJobType avoids conflict with legacy "JobType" enum in shared DB
enum PmsJobType {
  STILLS
  MOTION
  EVENTS
}

enum OppSource {
  EMAIL
  WHATSAPP
  DM
  REFERRAL
  OTHER
}

// Stage avoids conflict with legacy "OpportunityStage" enum in shared DB
enum Stage {
  ENQUIRY
  BIDDING
  QUOTED
  WON
  LOST
}

enum LostReason {
  COMPETITOR_WON
  BUDGET_PULLED
  NO_RESPONSE
  TIMING
  OTHER
}

enum ProductionStatus {
  PLANNING
  CONFIRMED
  IN_PRODUCTION
  WRAP
  DELIVERED
  INVOICED
  CLOSED
}

// ─── Settings ────────────────────────────────────────────────────────────────

model Settings {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pms_settings")
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Company {
  id            String        @id @default(cuid())
  name          String
  website       String?
  address       String?
  notes         String?
  contacts      Contact[]
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("pms_companies")
}

model Contact {
  id              String         @id @default(cuid())
  firstName       String
  lastName        String?
  email           String?
  phone           String?
  companyId       String?
  company         Company?       @relation(fields: [companyId], references: [id])
  jobTitle        String?
  type            ContactType    @default(CLIENT)
  source          ContactSource  @default(OTHER)
  tags            String[]       @default([])
  lastContactedAt DateTime?
  notes           String?
  opportunities   Opportunity[]
  crewMembers     CrewMember[]
  emailMessages   EmailMessage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@map("pms_contacts")
}

// ─── Opportunities ────────────────────────────────────────────────────────────

model Opportunity {
  id            String            @id @default(cuid())
  title         String
  clientName    String?
  brand         String?
  jobType       PmsJobType?
  source        OppSource         @default(OTHER)
  contactId     String?
  contact       Contact?          @relation(fields: [contactId], references: [id])
  companyId     String?
  company       Company?          @relation(fields: [companyId], references: [id])
  description   String?
  value         Decimal?          @db.Decimal(12, 2)
  stage         Stage             @default(ENQUIRY)
  followUpDate  DateTime?         @db.Date
  lostReason    LostReason?
  lostNote      String?
  dateReceived  DateTime?         @db.Date
  notes         String?
  productions   Production[]
  activityNotes OpportunityNote[]
  tasks         OpportunityTask[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@map("pms_opportunities")
}

model OpportunityNote {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("pms_opportunity_notes")
}

model OpportunityTask {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  body          String
  completed     Boolean     @default(false)
  completedAt   DateTime?
  dueDate       DateTime?   @db.Date
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("pms_opportunity_tasks")
}

// ─── Productions ─────────────────────────────────────────────────────────────

model Production {
  id            String           @id @default(cuid())
  title         String
  clientName    String?
  brand         String?
  jobType       PmsJobType?
  jobCode       String?          @unique
  description   String?
  status        ProductionStatus @default(PLANNING)
  value         Decimal?         @db.Decimal(12, 2)
  opportunityId String?
  opportunity   Opportunity?     @relation(fields: [opportunityId], references: [id])
  contactId     String?
  dates         ProductionDate[]
  crewMembers   CrewMember[]
  budgets       Budget[]
  jobFiles      JobFile[]
  emailThreads  EmailThread[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("pms_productions")
}

model ProductionDate {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  label        String?
  createdAt    DateTime   @default(now())

  @@map("pms_production_dates")
}

// ─── Crew ─────────────────────────────────────────────────────────────────────

model CrewRole {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  crewMembers CrewMember[]
  createdAt   DateTime     @default(now())

  @@map("pms_crew_roles")
}

model CrewMember {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?   @relation(fields: [contactId], references: [id])
  roleId       String?
  role         CrewRole?  @relation(fields: [roleId], references: [id])
  name         String
  email        String?
  phone        String?
  dayRate      Decimal?   @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("pms_crew_members")
}

// ─── Budgets ──────────────────────────────────────────────────────────────────

model Budget {
  id           String          @id @default(cuid())
  productionId String
  production   Production      @relation(fields: [productionId], references: [id], onDelete: Cascade)
  name         String
  sections     BudgetSection[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("pms_budgets")
}

model BudgetSection {
  id        String           @id @default(cuid())
  budgetId  String
  budget    Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name      String
  order     Int              @default(0)
  lineItems BudgetLineItem[]
  createdAt DateTime         @default(now())

  @@map("pms_budget_sections")
}

model BudgetLineItem {
  id          String            @id @default(cuid())
  sectionId   String
  section     BudgetSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal           @default(1) @db.Decimal(10, 3)
  unitCost    Decimal           @default(0) @db.Decimal(12, 2)
  total       Decimal           @default(0) @db.Decimal(12, 2)
  notes       String?
  order       Int               @default(0)
  invoices    LineItemInvoice[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("pms_budget_line_items")
}

model LineItemInvoice {
  id            String         @id @default(cuid())
  lineItemId    String
  lineItem      BudgetLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  invoiceNumber String?
  amount        Decimal        @db.Decimal(12, 2)
  invoiceDate   DateTime?      @db.Date
  notes         String?
  createdAt     DateTime       @default(now())

  @@map("pms_line_item_invoices")
}

// ─── Files ────────────────────────────────────────────────────────────────────

model JobFile {
  id           String      @id @default(cuid())
  productionId String?
  production   Production? @relation(fields: [productionId], references: [id])
  name         String
  url          String
  mimeType     String?
  size         Int?
  createdAt    DateTime    @default(now())

  @@map("pms_job_files")
}

// ─── Email ────────────────────────────────────────────────────────────────────

model EmailThread {
  id            String         @id @default(cuid())
  productionId  String?
  opportunityId String?
  production    Production?    @relation(fields: [productionId], references: [id])
  subject       String
  gmailThreadId String?        @unique
  messages      EmailMessage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("pms_email_threads")
}

model EmailMessage {
  id             String      @id @default(cuid())
  threadId       String
  thread         EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  gmailMessageId String?     @unique
  from           String
  to             String?
  subject        String?
  body           String?
  htmlBody       String?
  sentAt         DateTime?
  contactId      String?
  contact        Contact?    @relation(fields: [contactId], references: [id])
  createdAt      DateTime    @default(now())

  @@map("pms_email_messages")
}
