generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ContactType {
  CLIENT
  SUPPLIER
}

enum ContactSource {
  REFERRAL
  DIRECT
  SOCIAL
  PREVIOUS_JOB
  OTHER
}

enum BlackbookEntryType {
  PERSON
  COMPANY
  LOCATION
  TALENT
  SERVICE

  @@map("pms_blackbook_entry_type")
}

enum BlackbookCategory {
  CREW
  SERVICE
  LOCATION
  EQUIPMENT
  TALENT
  TRANSPORT
  POST
  OTHER

  @@map("pms_blackbook_category")
}

enum BlackbookLifecycleStatus {
  TARGET
  IN_TOUCH
  CLIENT
  PAST_CLIENT
  SUPPLIER
  PREFERRED_SUPPLIER
  DO_NOT_USE
  ARCHIVED

  @@map("pms_blackbook_lifecycle_status")
}

enum BlackbookOutreachStatus {
  NOT_CONTACTED
  CONTACTED
  REPLIED
  FOLLOW_UP
  NOT_INTERESTED
  CONVERTED
  ARCHIVED

  @@map("pms_blackbook_outreach_status")
}

enum BlackbookAddressType {
  WORK
  BILLING
  PERSONAL
  CUSTOM

  @@map("pms_blackbook_address_type")
}

enum BlackbookAddressSource {
  MANUAL
  GOOGLE_PLACES

  @@map("pms_blackbook_address_source")
}

// PmsJobType avoids conflict with legacy "JobType" enum in shared DB
enum PmsJobType {
  STILLS
  MOTION
  EVENTS
}

enum OppSource {
  EMAIL
  WHATSAPP
  DM
  REFERRAL
  OTHER
}

// Stage avoids conflict with legacy "OpportunityStage" enum in shared DB
enum Stage {
  ENQUIRY
  BIDDING
  QUOTED
  WON
  LOST
}

enum LostReason {
  COMPETITOR_WON
  BUDGET_PULLED
  NO_RESPONSE
  TIMING
  OTHER
}

enum ProductionStatus {
  PRE_PRO
  SHOOT
  POST
  WRAPPED
  PLANNING
  CONFIRMED
  IN_PRODUCTION
  WRAP
  DELIVERED
  INVOICED
  CLOSED
}

enum FreeAgentInvoiceStatus {
  NOT_RAISED
  DRAFT
  SENT
  VIEWED
  PAID
  OVERDUE
}

enum ProductionDateType {
  PPM
  RECCE
  FITTING
  MEETING
  SHOOT_DAY
  POST_DELIVERY
  OTHER
}

enum ProductionDateStatus {
  PROPOSED
  OPTIONED
  CONFIRMED
  RELEASED
  CANCELLED

  @@map("pms_production_date_status")
}

enum CrewStatus {
  REQUESTED
  FIRST_OPTION
  SECOND_OPTION
  CONFIRMED
  RELEASED
}

enum ActivityEntityType {
  PRODUCTION
  OPPORTUNITY
}

enum BudgetStatus {
  DRAFT
  SENT
  CONFIRMED
  IN_PRODUCTION
  WRAPPED

  @@map("pms_budget_status")
}

enum RevisionStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  SUPERSEDED

  @@map("pms_revision_status")
}

enum SubCostStatus {
  PENDING
  AGREED
  INVOICED
  PAID

  @@map("pms_sub_cost_status")
}

enum SubCostLineType {
  PO
  BILL
  RECEIPT

  @@map("pms_sub_cost_line_type")
}

enum AdvanceCalcType {
  PERCENT_OF_TOTAL
  PERCENT_OF_PRODUCTION
  FIXED_AMOUNT

  @@map("pms_advance_calc_type")
}

enum ReceiptCaptureStatus {
  PENDING
  PARSING
  PARSED
  ASSIGNED
  FAILED

  @@map("pms_receipt_capture_status")
}

enum EmailProvider {
  GOOGLE
  IMAP
}

enum CalendarEventType {
  SHOOT_DAY
  PPM
  RECCE
  FITTING
  MEETING
  POST_DELIVERY
  FOLLOW_UP
  GOOGLE_SYNC
  STANDALONE
  OTHER

  @@map("pms_calendar_event_type")
}

// ─── Settings ────────────────────────────────────────────────────────────────

model Settings {
  id                    String   @id @default(cuid())
  email                 String   @unique
  password              String
  jobCodeYear           Int      @default(2026)
  jobCodeSequence       Int      @default(46)
  defaultEmailSignature String   @default("")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("pms_settings")
}

// ─── Contacts ────────────────────────────────────────────────────────────────

model Company {
  id            String        @id @default(cuid())
  name          String
  website       String?
  address       String?
  notes         String?
  contacts      Contact[]
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("pms_companies")
}

model Contact {
  id               String                 @id @default(cuid())
  firstName        String
  lastName         String?
  email            String?
  phone            String?
  companyId        String?
  company          Company?               @relation(fields: [companyId], references: [id])
  jobTitle         String?
  type             ContactType            @default(CLIENT)
  source           ContactSource          @default(OTHER)
  tags             String[]               @default([])
  lastContactedAt  DateTime?
  notes            String?
  opportunities    Opportunity[]
  crewMembers      CrewMember[]
  productionDates  ProductionDatePerson[]
  emailThreads     EmailThread[]
  emailDrafts      EmailDraft[]
  blackbookEntries BlackbookEntry[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@map("pms_contacts")
}

model BlackbookConfigCategory {
  id         String                @id @default(uuid())
  name       String
  slug       String                @unique
  broadType  BlackbookCategory     @default(OTHER)
  color      String                @default("#1a1a1f")
  order      Int                   @default(0)
  coreFields Json                  @default("[]")
  types      BlackbookConfigType[]
  entries    BlackbookEntry[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@map("pms_blackbook_config_categories")
}

model BlackbookConfigType {
  id         String                  @id @default(uuid())
  categoryId String
  name       String
  slug       String
  order      Int                     @default(0)
  category   BlackbookConfigCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@unique([categoryId, slug])
  @@map("pms_blackbook_config_types")
}

model BlackbookTargetList {
  id          String                     @id @default(uuid())
  name        String
  description String?
  isArchived  Boolean                    @default(false)
  entries     BlackbookTargetListEntry[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@map("pms_blackbook_target_lists")
}

model BlackbookTargetListEntry {
  id             String                  @id @default(uuid())
  listId         String
  entryId        String
  status         BlackbookOutreachStatus @default(NOT_CONTACTED)
  notes          String?
  nextFollowUpAt DateTime?               @db.Date
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  list  BlackbookTargetList @relation(fields: [listId], references: [id], onDelete: Cascade)
  entry BlackbookEntry      @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([listId, entryId])
  @@index([entryId])
  @@map("pms_blackbook_target_list_entries")
}

model BlackbookEntry {
  id               String                   @id @default(uuid())
  entryType        BlackbookEntryType       @default(PERSON)
  category         BlackbookCategory        @default(OTHER)
  categoryConfigId String?
  typeIds          String[]                 @default([])
  lifecycleStatus  BlackbookLifecycleStatus @default(IN_TOUCH)
  companyEntryId   String?
  displayName      String
  firstName        String?
  lastName         String?
  companyName      String?
  jobTitle         String?
  email            String?
  phone            String?
  website          String?
  tags             String[]                 @default([])
  notes            String?

  // Commercial defaults
  defaultRate Float?
  rateUnit    String?
  currency    String  @default("GBP")

  // Person-level catering requirements. Production-specific overrides can be
  // added later without losing the reusable blackbook baseline.
  dietaryNotes String?
  dietaryFlags String[] @default([])
  allergens    String[] @default([])

  // Structured location/company address fields for filtering and deck output.
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postcode     String?
  country      String?
  locationType String?
  latitude     Float?
  longitude    Float?

  // Location/studio technical fields seen in the historical decks.
  daylight        Boolean?
  blackout        Boolean?
  areaSqm         Float?
  shootingAreaSqm Float?
  ceilingHeight   String?
  accessNotes     String?
  parkingNotes    String?
  travelNotes     String?
  facilities      String?

  // Talent/model fields from casting decks.
  ukAgency     String?
  frAgency     String?
  bookUrl      String?
  socialUrl    String?
  polasUrl     String?
  selfTapeUrl  String?
  modelsComUrl String?
  height       String?
  eyes         String?
  hair         String?
  bust         String?
  waist        String?
  hips         String?
  shoe         String?

  addresses        BlackbookAddress[]
  optionCandidates OptionCandidate[]
  contactId        String?
  contact          Contact?                   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  categoryConfig   BlackbookConfigCategory?   @relation(fields: [categoryConfigId], references: [id], onDelete: SetNull)
  companyEntry     BlackbookEntry?            @relation("BlackbookCompanyPeople", fields: [companyEntryId], references: [id], onDelete: SetNull)
  people           BlackbookEntry[]           @relation("BlackbookCompanyPeople")
  targetLists      BlackbookTargetListEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entryType, category])
  @@index([categoryConfigId])
  @@index([lifecycleStatus])
  @@index([companyEntryId])
  @@index([contactId])
  @@index([displayName])
  @@index([email])
  @@map("pms_blackbook_entries")
}

model BlackbookAddress {
  id               String                 @id @default(uuid())
  entryId          String
  type             BlackbookAddressType   @default(WORK)
  label            String?
  isDefaultBilling Boolean                @default(false)
  source           BlackbookAddressSource @default(MANUAL)
  placeId          String?
  placeName        String?
  formattedAddress String?
  addressLine1     String?
  addressLine2     String?
  city             String?
  region           String?
  postcode         String?
  country          String?
  latitude         Float?
  longitude        Float?
  website          String?
  phone            String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  entry            BlackbookEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  optionCandidates OptionCandidate[]

  @@index([entryId])
  @@map("pms_blackbook_addresses")
}

// ─── Opportunities ────────────────────────────────────────────────────────────

model Opportunity {
  id             String            @id @default(cuid())
  title          String
  clientName     String?
  brand          String?
  jobType        PmsJobType?
  source         OppSource         @default(OTHER)
  contactId      String?
  contact        Contact?          @relation(fields: [contactId], references: [id])
  companyId      String?
  company        Company?          @relation(fields: [companyId], references: [id])
  description    String?
  value          Decimal?          @db.Decimal(12, 2)
  stage          Stage             @default(ENQUIRY)
  followUpDate   DateTime?         @db.Date
  lostReason     LostReason?
  lostNote       String?
  dateReceived   DateTime?         @db.Date
  notes          String?
  productions    Production[]
  budgets        Budget[]
  activityNotes  OpportunityNote[]
  tasks          OpportunityTask[]
  emailThreads   EmailThread[]
  emailDrafts    EmailDraft[]
  calendarEvents CalendarEvent[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("pms_opportunities")
}

model OpportunityNote {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  body          String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("pms_opportunity_notes")
}

model OpportunityTask {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  body          String
  completed     Boolean     @default(false)
  completedAt   DateTime?
  dueDate       DateTime?   @db.Date
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("pms_opportunity_tasks")
}

// ─── Productions ─────────────────────────────────────────────────────────────

model Production {
  id                     String                 @id @default(cuid())
  title                  String
  clientName             String?
  brand                  String?
  jobType                PmsJobType?
  jobCode                String?                @unique
  description            String?
  status                 ProductionStatus       @default(PRE_PRO)
  value                  Decimal?               @db.Decimal(12, 2)
  freeAgentInvoiceStatus FreeAgentInvoiceStatus @default(NOT_RAISED)
  notes                  String?
  storagePath            String?
  lastPoSequence         Int                    @default(0)
  actualSpend            Float                  @default(0)
  variance               Float                  @default(0)
  opportunityId          String?
  opportunity            Opportunity?           @relation(fields: [opportunityId], references: [id])
  contactId              String?
  dates                  ProductionDate[]
  crewMembers            CrewMember[]
  budgets                Budget[]
  jobFiles               JobFile[]
  emailThreads           EmailThread[]
  emailDrafts            EmailDraft[]
  receiptCaptures        ReceiptCapture[]
  calendarEvents         CalendarEvent[]
  optionsBoard           OptionsBoard?
  optionGroups           OptionGroup[]
  optionRequirements     OptionRequirement[]
  optionCandidates       OptionCandidate[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@map("pms_productions")
}

model OptionsBoard {
  id           String            @id @default(uuid())
  productionId String            @unique
  title        String            @default("Options")
  categories   OptionsCategory[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@map("pms_options_boards")
}

model OptionGroup {
  id           String                @id @default(uuid())
  productionId String
  name         String
  type         OptionRequirementType @default(OTHER)
  order        Int                   @default(0)
  requirements OptionRequirement[]
  candidates   OptionCandidate[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  production Production @relation(fields: [productionId], references: [id], onDelete: Cascade)

  @@index([productionId, order])
  @@map("pms_option_groups")
}

model OptionRequirement {
  id           String                 @id @default(uuid())
  productionId String
  groupId      String
  name         String
  displayLabel String
  type         OptionRequirementType  @default(OTHER)
  slotNumber   Int                    @default(1)
  activeState  OptionRequirementState @default(ACTIVE)
  notes        String?
  order        Int                    @default(0)
  dateNeeds    RequirementDateNeed[]
  assignments  OptionSlotAssignment[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  production Production  @relation(fields: [productionId], references: [id], onDelete: Cascade)
  group      OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([productionId, order])
  @@index([groupId])
  @@map("pms_option_requirements")
}

model RequirementDateNeed {
  id            String   @id @default(uuid())
  requirementId String
  dateId        String
  isRequired    Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirement OptionRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  date        ProductionDate    @relation(fields: [dateId], references: [id], onDelete: Cascade)

  @@unique([requirementId, dateId])
  @@index([dateId])
  @@map("pms_requirement_date_needs")
}

model OptionCandidate {
  id                String                      @id @default(uuid())
  productionId      String
  groupId           String
  blackbookEntryId  String?
  selectedAddressId String?
  name              String
  subtitle          String?
  website           String?
  contactName       String?
  contactEmail      String?
  contactPhone      String?
  bookUrl           String?
  socialUrl         String?
  modelsComUrl      String?
  pdfUrl            String?
  pdfFilename       String?
  pdfStoredPath     String?
  pdfSizeBytes      Int?
  pdfPublicToken    String?                     @unique
  addressLine1      String?
  addressLine2      String?
  city              String?
  region            String?
  postcode          String?
  country           String?
  locationType      String?
  rate              Float?
  rateUnit          String?
  currency          String                      @default("GBP")
  activeState       OptionCandidateState        @default(ACTIVE)
  internalNotes     String?
  clientNotes       String?
  order             Int                         @default(0)
  dateStatuses      CandidateDateStatusRecord[]
  assignments       OptionSlotAssignment[]
  photos            OptionCandidatePhoto[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  production      Production        @relation(fields: [productionId], references: [id], onDelete: Cascade)
  group           OptionGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  blackbookEntry  BlackbookEntry?   @relation(fields: [blackbookEntryId], references: [id], onDelete: SetNull)
  selectedAddress BlackbookAddress? @relation(fields: [selectedAddressId], references: [id], onDelete: SetNull)

  @@index([productionId])
  @@index([groupId, order])
  @@index([blackbookEntryId])
  @@index([selectedAddressId])
  @@map("pms_option_candidates")
}

model OptionCandidatePhoto {
  id             String   @id @default(uuid())
  candidateId    String
  filename       String
  storedPath     String
  sizeBytes      Int
  width          Int?
  height         Int?
  order          Int      @default(0)
  caption        String?
  exportSelected Boolean  @default(true)
  createdAt      DateTime @default(now())

  candidate OptionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, order])
  @@map("pms_option_candidate_photos")
}

model CandidateDateStatusRecord {
  id          String                  @id @default(uuid())
  candidateId String
  dateId      String
  status      CandidateDateHoldStatus @default(REQUESTED)
  notes       String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  candidate OptionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  date      ProductionDate  @relation(fields: [dateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, dateId])
  @@index([dateId])
  @@map("pms_candidate_date_statuses")
}

model OptionSlotAssignment {
  id            String   @id @default(uuid())
  requirementId String
  candidateId   String
  dateId        String
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  requirement OptionRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  candidate   OptionCandidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  date        ProductionDate    @relation(fields: [dateId], references: [id], onDelete: Cascade)

  @@unique([requirementId, dateId])
  @@index([candidateId])
  @@index([dateId])
  @@map("pms_option_slot_assignments")
}

enum OptionRequirementType {
  CREW
  SERVICE
  LOCATION
  EQUIPMENT
  TALENT
  TRANSPORT
  POST
  OTHER

  @@map("pms_option_requirement_type")
}

enum OptionRequirementState {
  ACTIVE
  PARKED
  RELEASED

  @@map("pms_option_requirement_state")
}

enum OptionCandidateState {
  ACTIVE
  PARKED
  RELEASED

  @@map("pms_option_candidate_state")
}

enum CandidateDateHoldStatus {
  REQUESTED
  FIRST_OPTION
  SECOND_OPTION
  CONFIRMED
  RELEASED
  UNAVAILABLE
  NA

  @@map("pms_candidate_date_hold_status")
}

model OptionsCategory {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  emoji     String?
  order     Int      @default(0)
  options   Option[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  board OptionsBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@map("pms_options_categories")
}

model Option {
  id             String             @id @default(uuid())
  categoryId     String
  name           String
  subtitle       String?
  website        String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  rate           Float?
  rateUnit       String?
  currency       String             @default("GBP")
  status         OptionStatus       @default(OPTION)
  isAvailable    OptionAvailability @default(UNKNOWN)
  internalNotes  String?
  clientNotes    String?
  photos         OptionPhoto[]
  order          Int                @default(0)
  libraryEntryId String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  category OptionsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("pms_options")
}

model OptionPhoto {
  id         String   @id @default(uuid())
  optionId   String
  filename   String
  storedPath String
  sizeBytes  Int
  order      Int      @default(0)
  caption    String?
  createdAt  DateTime @default(now())

  option Option @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@map("pms_option_photos")
}

enum OptionStatus {
  RECOMMENDED
  RESEARCHED
  OPTION
  SHORTLISTED
  NOT_AVAILABLE

  @@map("pms_option_status")
}

enum OptionAvailability {
  AVAILABLE
  UNAVAILABLE
  TBC
  UNKNOWN

  @@map("pms_option_availability")
}

model ProductionDate {
  id                    String                      @id @default(cuid())
  productionId          String
  production            Production                  @relation(fields: [productionId], references: [id], onDelete: Cascade)
  dateType              ProductionDateType          @default(OTHER)
  status                ProductionDateStatus        @default(PROPOSED)
  date                  DateTime                    @db.Date
  time                  String?
  location              String?
  zoomLink              String?
  notes                 String?
  label                 String?
  people                ProductionDatePerson[]
  requirementNeeds      RequirementDateNeed[]
  candidateStatuses     CandidateDateStatusRecord[]
  optionSlotAssignments OptionSlotAssignment[]
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  @@map("pms_production_dates")
}

model ProductionDatePerson {
  id               String         @id @default(cuid())
  productionDateId String
  productionDate   ProductionDate @relation(fields: [productionDateId], references: [id], onDelete: Cascade)
  contactId        String
  contact          Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())

  @@unique([productionDateId, contactId])
  @@map("pms_production_date_people")
}

model CalendarEvent {
  id                    String            @id @default(uuid())
  title                 String
  startDate             DateTime
  endDate               DateTime
  isAllDay              Boolean           @default(false)
  location              String?
  zoomLink              String?
  notes                 String?
  color                 String?
  eventType             CalendarEventType @default(STANDALONE)
  productionId          String?
  productionDateId      String?
  opportunityId         String?
  contactIds            String[]          @default([])
  googleCalendarEventId String?
  googleCalendarId      String?
  syncedFromGoogle      Boolean           @default(false)
  lastSyncedAt          DateTime?
  production            Production?       @relation(fields: [productionId], references: [id], onDelete: SetNull)
  opportunity           Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([startDate])
  @@index([endDate])
  @@index([productionId])
  @@index([productionDateId])
  @@index([opportunityId])
  @@index([googleCalendarEventId])
  @@map("pms_calendar_events")
}

// ─── Crew ─────────────────────────────────────────────────────────────────────

model CrewRole {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  crewMembers CrewMember[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("pms_crew_roles")
}

model CrewMember {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?   @relation(fields: [contactId], references: [id])
  roleId       String?
  role         CrewRole?  @relation(fields: [roleId], references: [id])
  name         String
  email        String?
  phone        String?
  status       CrewStatus @default(REQUESTED)
  dayRate      Decimal?   @db.Decimal(10, 2)
  numberOfDays Decimal    @default(1) @db.Decimal(6, 2)
  notes        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("pms_crew_members")
}

// ─── Budgets ──────────────────────────────────────────────────────────────────

model Budget {
  id                   String           @id @default(uuid())
  productionId         String?          @unique
  opportunityId        String?          @unique
  jobName              String?
  jobLocation          String?
  shotCount            String?
  prepTravelDate       String?
  shootDates           String?
  photographerDirector String?
  accountingContact    String?
  comments             String?
  caveats              String?
  usages               String?
  productionFeePercent Float            @default(10)
  insurancePercent     Float            @default(0)
  currencyBase         String           @default("GBP")
  currencySecondary    String?
  currencyRate         Float?
  status               BudgetStatus     @default(DRAFT)
  version              Int              @default(1)
  currentRevisionId    String?          @unique
  currentRevision      BudgetRevision?  @relation("CurrentBudgetRevision", fields: [currentRevisionId], references: [id])
  revisions            BudgetRevision[] @relation("BudgetRevisions")
  advanceInvoices      AdvanceInvoice[]
  production           Production?      @relation(fields: [productionId], references: [id], onDelete: SetNull)
  opportunity          Opportunity?     @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@map("pms_budgets")
}

model BudgetRevision {
  id                   String          @id @default(uuid())
  budgetId             String
  budget               Budget          @relation("BudgetRevisions", fields: [budgetId], references: [id], onDelete: Cascade)
  currentForBudget     Budget?         @relation("CurrentBudgetRevision")
  revisionNumber       Int
  label                String          @default("Original")
  status               RevisionStatus  @default(DRAFT)
  productionFeePercent Float           @default(10)
  insurancePercent     Float           @default(0)
  notes                String?
  sections             BudgetSection[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@unique([budgetId, revisionNumber])
  @@map("pms_budget_revisions")
}

model BudgetSection {
  id         String           @id @default(uuid())
  revisionId String
  revision   BudgetRevision   @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  code       String
  name       String
  order      Int              @default(0)
  isVisible  Boolean          @default(true)
  lineItems  BudgetLineItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([revisionId, code])
  @@map("pms_budget_sections")
}

model BudgetLineItem {
  id               String           @id @default(uuid())
  sectionId        String
  lineCode         String
  description      String
  clientNotes      String?
  internalNotes    String?
  qty              Float            @default(1)
  days             Float            @default(1)
  rate             Float            @default(0)
  unit             String           @default("Days")
  agencyFeePercent Float?           @default(0)
  estimatedTotal   Float            @default(0)
  actualTotal      Float            @default(0)
  variance         Float            @default(0)
  isAgreed         Boolean          @default(false)
  isClosed         Boolean          @default(false)
  subCosts         SubCost[]
  order            Int              @default(0)
  isSubItem        Boolean          @default(false)
  parentId         String?
  reconNotes       String?
  section          BudgetSection    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  parent           BudgetLineItem?  @relation("SubItems", fields: [parentId], references: [id])
  children         BudgetLineItem[] @relation("SubItems")
  jobFiles         JobFile[]
  receiptCaptures  ReceiptCapture[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([sectionId])
  @@index([parentId])
  @@map("pms_budget_line_items")
}

model SubCost {
  id                     String          @id @default(uuid())
  lineItemId             String
  lineType               SubCostLineType @default(PO)
  poNumber               String?
  description            String
  supplierName           String?
  amount                 Float
  amountGross            Float?
  vatAmount              Float?
  vatRate                Float?
  currency               String          @default("GBP")
  status                 SubCostStatus   @default(PENDING)
  invoiceNumber          String?
  invoiceDate            DateTime?
  datePaid               DateTime?
  invoiceFileId          String?
  proofOfPayment         String?
  isAgreed               Boolean         @default(false)
  isInvoiced             Boolean         @default(false)
  isPaid                 Boolean         @default(false)
  freeAgentTransactionId String?
  receiptCaptureId       String?
  lineItem               BudgetLineItem  @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  invoiceFile            JobFile?        @relation("InvoiceFile", fields: [invoiceFileId], references: [id])
  popFile                JobFile?        @relation("POPFile", fields: [proofOfPayment], references: [id])
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  @@index([lineItemId])
  @@index([invoiceFileId])
  @@index([proofOfPayment])
  @@map("pms_sub_costs")
}

model AdvanceInvoice {
  id                 String          @id @default(uuid())
  budgetId           String
  label              String
  percent            Float?
  amount             Float?
  calculationType    AdvanceCalcType @default(PERCENT_OF_TOTAL)
  calculatedAmount   Float?
  isPaid             Boolean         @default(false)
  datePaid           DateTime?
  freeAgentInvoiceId String?
  dueDate            DateTime?
  notes              String?
  budget             Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([budgetId])
  @@map("pms_advance_invoices")
}

model SectionTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean  @default(false)
  sections    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("pms_section_templates")
}

// ─── Files ────────────────────────────────────────────────────────────────────

model JobFile {
  id                         String           @id @default(cuid())
  productionId               String?
  production                 Production?      @relation(fields: [productionId], references: [id], onDelete: SetNull)
  folder                     String
  originalFilename           String
  storedFilename             String
  mimeType                   String
  sizeBytes                  Int
  uploadedAt                 DateTime         @default(now())
  linkedBudgetLineId         String?
  linkedBudgetLine           BudgetLineItem?  @relation(fields: [linkedBudgetLineId], references: [id])
  isReceipt                  Boolean          @default(false)
  receiptVendor              String?
  receiptAmount              Int?
  receiptDate                DateTime?        @db.Date
  notes                      String?
  sourceEmailThreadId        String?
  sourceEmailThread          EmailThread?     @relation("JobFileSourceEmailThread", fields: [sourceEmailThreadId], references: [id], onDelete: SetNull)
  sourceEmailMessageId       String?
  sourceEmailMessage         EmailMessage?    @relation("JobFileSourceEmailMessage", fields: [sourceEmailMessageId], references: [id], onDelete: SetNull)
  sourceEmailAttachmentIndex Int?
  sourceEmailFilename        String?
  subCostInvoiceFiles        SubCost[]        @relation("InvoiceFile")
  subCostPopFiles            SubCost[]        @relation("POPFile")
  receiptCaptures            ReceiptCapture[]

  @@index([productionId, folder])
  @@index([originalFilename])
  @@index([sourceEmailThreadId])
  @@index([sourceEmailMessageId, sourceEmailAttachmentIndex])
  @@map("pms_job_files")
}

model ReceiptCapture {
  id                    String               @id @default(uuid())
  status                ReceiptCaptureStatus @default(PENDING)
  originalFilename      String
  storedFilename        String
  mimeType              String
  sizeBytes             Int
  storedPath            String
  parsedVendor          String?
  parsedAmount          Int?
  parsedAmountGross     Int?
  parsedAmountNet       Int?
  parsedVatAmount       Int?
  parsedVatRate         Float?
  parsedDate            DateTime?            @db.Date
  parsedCurrency        String               @default("GBP")
  parsedDescription     String?
  parsedAicpSection     String?
  parsedAicpSectionName String?
  parseConfidence       String?
  parseRawText          String?
  parsedAt              DateTime?
  productionId          String?
  production            Production?          @relation(fields: [productionId], references: [id], onDelete: SetNull)
  lineItemId            String?
  lineItem              BudgetLineItem?      @relation(fields: [lineItemId], references: [id], onDelete: SetNull)
  jobFileId             String?
  jobFile               JobFile?             @relation(fields: [jobFileId], references: [id], onDelete: SetNull)
  assignedAt            DateTime?
  capturedOffline       Boolean              @default(false)
  syncedAt              DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([status])
  @@index([productionId])
  @@index([lineItemId])
  @@index([jobFileId])
  @@map("pms_receipt_captures")
}

// ─── Email ────────────────────────────────────────────────────────────────────

model EmailAccount {
  id                    String        @id @default(uuid())
  label                 String
  emailAddress          String
  provider              EmailProvider
  imapHost              String?
  imapPort              Int?
  smtpHost              String?
  smtpPort              Int?
  username              String?
  encryptedPassword     String?
  encryptedAccessToken  String?
  encryptedRefreshToken String?
  tokenExpiry           DateTime?
  isActive              Boolean       @default(true)
  isPrimary             Boolean       @default(false)
  lastSyncedAt          DateTime?
  gmailHistoryId        String?
  threads               EmailThread[]
  drafts                EmailDraft[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@map("pms_email_accounts")
}

model EmailDraft {
  id                  String       @id @default(uuid())
  accountId           String
  account             EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  to                  String[]     @default([])
  cc                  String[]     @default([])
  bcc                 String[]     @default([])
  subject             String       @default("")
  bodyHtml            String       @default("")
  replyToThreadId     String?
  gmailThreadId       String?
  inReplyToMsgId      String?
  references          String?
  linkedOpportunityId String?
  linkedOpportunity   Opportunity? @relation(fields: [linkedOpportunityId], references: [id], onDelete: SetNull)
  linkedProductionId  String?
  linkedProduction    Production?  @relation(fields: [linkedProductionId], references: [id], onDelete: SetNull)
  linkedContactId     String?
  linkedContact       Contact?     @relation(fields: [linkedContactId], references: [id], onDelete: SetNull)
  isMinimized         Boolean      @default(false)
  lastEditedAt        DateTime     @default(now())
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([accountId, lastEditedAt])
  @@index([replyToThreadId])
  @@index([linkedOpportunityId])
  @@index([linkedProductionId])
  @@index([linkedContactId])
  @@map("pms_email_drafts")
}

model EmailThread {
  id                  String         @id @default(uuid())
  accountId           String?
  account             EmailAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  externalThreadId    String         @default(uuid())
  gmailThreadId       String?
  historyId           String?
  subject             String
  snippet             String?
  participants        String[]       @default([])
  participantNames    String[]       @default([])
  lastMessageAt       DateTime       @default(now())
  lastInboxMessageAt  DateTime?
  lastSentMessageAt   DateTime?
  isRead              Boolean        @default(false)
  isFlagged           Boolean        @default(false)
  isArchived          Boolean        @default(false)
  inInbox             Boolean        @default(false)
  inSent              Boolean        @default(false)
  isStarred           Boolean        @default(false)
  isUnread            Boolean        @default(false)
  isTrashed           Boolean        @default(false)
  linkedContactId     String?
  linkedContact       Contact?       @relation(fields: [linkedContactId], references: [id], onDelete: SetNull)
  linkedOpportunityId String?
  linkedOpportunity   Opportunity?   @relation(fields: [linkedOpportunityId], references: [id], onDelete: SetNull)
  linkedProductionId  String?
  linkedProduction    Production?    @relation(fields: [linkedProductionId], references: [id], onDelete: SetNull)
  messages            EmailMessage[]
  sourceJobFiles      JobFile[]      @relation("JobFileSourceEmailThread")
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([accountId, externalThreadId])
  @@unique([accountId, gmailThreadId])
  @@index([lastMessageAt])
  @@index([accountId, inInbox, lastMessageAt])
  @@index([accountId, inSent, lastSentMessageAt])
  @@index([accountId, isStarred])
  @@index([accountId, isUnread])
  @@index([linkedContactId])
  @@index([linkedOpportunityId])
  @@index([linkedProductionId])
  @@map("pms_email_threads")
}

model ActivityNote {
  id         String             @id @default(cuid())
  entityType ActivityEntityType
  entityId   String
  body       String
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([entityType, entityId])
  @@map("pms_activity_notes")
}

model ActivityTask {
  id          String             @id @default(cuid())
  entityType  ActivityEntityType
  entityId    String
  body        String
  completed   Boolean            @default(false)
  completedAt DateTime?
  dueDate     DateTime?          @db.Date
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([entityType, entityId])
  @@map("pms_activity_tasks")
}

model EmailMessage {
  id                 String      @id @default(uuid())
  threadId           String
  thread             EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  externalMessageId  String      @unique
  gmailMessageId     String?     @unique
  gmailThreadId      String?
  labelIds           String[]    @default([])
  inInbox            Boolean     @default(false)
  inSent             Boolean     @default(false)
  isUnread           Boolean     @default(false)
  isStarred          Boolean     @default(false)
  fromAddress        String
  fromName           String?
  toAddresses        String[]    @default([])
  ccAddresses        String[]    @default([])
  bccAddresses       String[]    @default([])
  subject            String
  bodyHtml           String      @default("")
  bodyText           String      @default("")
  snippet            String?
  sentAt             DateTime
  isFromMe           Boolean     @default(false)
  hasAttachments     Boolean     @default(false)
  attachments        Json        @default("[]")
  gmailAttachmentIds Json        @default("[]")
  imapMailbox        String?
  imapUid            Int?
  sourceJobFiles     JobFile[]   @relation("JobFileSourceEmailMessage")
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([threadId, sentAt])
  @@index([gmailThreadId])
  @@index([imapMailbox, imapUid])
  @@map("pms_email_messages")
}

model EmailTemplate {
  id         String   @id @default(uuid())
  name       String
  subject    String
  bodyHtml   String
  defaultCc  String?
  defaultBcc String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("pms_email_templates")
}
