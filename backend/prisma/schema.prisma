// ─── Budgets ──────────────────────────────────────────────────────────────────

model Budget {
  id                   String               @id @default(uuid())
  productionId         String?              @unique
  opportunityId        String?              @unique
  jobName              String?
  jobLocation          String?
  shotCount            String?
  prepTravelDate       String?
  shootDates           String?
  photographerDirector String?
  accountingContact    String?
  comments             String?
  caveats              String?
  usages               String?
  productionFeePercent Float                @default(10)
  insurancePercent     Float                @default(0)
  productionFeeEnabled Boolean              @default(true)
  insuranceEnabled     Boolean              @default(true)
  currencyBase         String               @default("GBP")
  currencySecondary    String?
  currencyRate         Float?
  status               BudgetStatus         @default(DRAFT)
  version              Int                  @default(1)
  currentRevisionId    String?              @unique
  currentRevision      BudgetRevision?      @relation("CurrentBudgetRevision", fields: [currentRevisionId], references: [id])
  revisions            BudgetRevision[]     @relation("BudgetRevisions")
  advanceInvoices      AdvanceInvoice[]
  purchaseOrders       PurchaseOrderGroup[]
  production           Production?          @relation(fields: [productionId], references: [id], onDelete: SetNull)
  opportunity          Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@map("pms_budgets")
}

model BudgetRevision {
  editVersion Int @default(1)
  id                   String               @id @default(uuid())
  budgetId             String
  budget               Budget               @relation("BudgetRevisions", fields: [budgetId], references: [id], onDelete: Cascade)
  currentForBudget     Budget?              @relation("CurrentBudgetRevision")
  revisionNumber       Int
  majorVersion         Int                  @default(1)
  minorVersion         Int                  @default(0)
  label                String               @default("Original")
  status               RevisionStatus       @default(DRAFT)
  productionFeePercent Float                @default(10)
  insurancePercent     Float                @default(0)
  productionFeeEnabled Boolean              @default(true)
  insuranceEnabled     Boolean              @default(true)
  notes                String?
  estimateDescription  String?
  includedNotes        String?
  notIncludedNotes     String?
  assumptions          String?
  paymentTerms         String?
  validUntil           DateTime?
  representative       String?
  sourceRevisionId     String?
  isLocked             Boolean              @default(false)
  lockedAt             DateTime?
  changeSummary        String?
  sections             BudgetSection[]
  transfers            BudgetLineTransfer[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([budgetId, revisionNumber])
  @@index([budgetId, majorVersion, minorVersion])
  @@map("pms_budget_revisions")
}

model BudgetSection {
  id         String           @id @default(uuid())
  revisionId String
  revision   BudgetRevision   @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  code       String
  name       String
  order      Int              @default(0)
  isVisible  Boolean          @default(true)
  lineItems  BudgetLineItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([revisionId, code])
  @@map("pms_budget_sections")
}

model BudgetLineItem {
  plannedUnitCost Float?
  plannedSupplier String?
  stableCostKey String @default(dbgenerated("gen_random_uuid()::text"))
  id               String               @id @default(uuid())
  sectionId        String
  lineCode         String
  description      String
  clientNotes      String?
  internalNotes    String?
  qty              Float                @default(1)
  days             Float                @default(1)
  rate             Float                @default(0)
  unit             String               @default("Days")
  agencyFeePercent Float?               @default(0)
  estimatedTotal   Float                @default(0)
  actualTotal      Float                @default(0)
  variance         Float                @default(0)
  isAgreed         Boolean              @default(false)
  isClosed         Boolean              @default(false)
  subCosts         SubCost[]
  order            Int                  @default(0)
  isSubItem        Boolean              @default(false)
  parentId         String?
  reconNotes       String?
  section          BudgetSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  parent           BudgetLineItem?      @relation("SubItems", fields: [parentId], references: [id])
  children         BudgetLineItem[]     @relation("SubItems")
  jobFiles         JobFile[]
  receiptCaptures  ReceiptCapture[]
  transfersOut     BudgetLineTransfer[] @relation("BudgetTransferFrom")
  transfersIn      BudgetLineTransfer[] @relation("BudgetTransferTo")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([sectionId])
  @@index([parentId])
  @@map("pms_budget_line_items")
}

model BudgetLineTransfer {
  id             String   @id @default(uuid())
  revisionId     String
  fromLineItemId String
  toLineItemId   String
  amount         Float
  reason         String?
  createdAt      DateTime @default(now())

  revision     BudgetRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  fromLineItem BudgetLineItem @relation("BudgetTransferFrom", fields: [fromLineItemId], references: [id], onDelete: Cascade)
  toLineItem   BudgetLineItem @relation("BudgetTransferTo", fields: [toLineItemId], references: [id], onDelete: Cascade)

  @@index([revisionId])
  @@index([fromLineItemId])
  @@index([toLineItemId])
  @@map("pms_budget_line_transfers")
}

model SubCost {
  id                     String              @id @default(uuid())
  lineItemId             String
  purchaseOrderGroupId   String?
  lineType               SubCostLineType     @default(PO)
  poNumber               String?
  description            String
  supplierName           String?
  amount                 Float
  amountGross            Float?
  vatAmount              Float?
  vatRate                Float?
  currency               String              @default("GBP")
  status                 SubCostStatus       @default(PENDING)
  invoiceNumber          String?
  invoiceDate            DateTime?
  datePaid               DateTime?
  invoiceFileId          String?
  proofOfPayment         String?
  isAgreed               Boolean             @default(false)
  isInvoiced             Boolean             @default(false)
  isPaid                 Boolean             @default(false)
  freeAgentTransactionId String?
  receiptCaptureId       String?
  lineItem               BudgetLineItem      @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  purchaseOrderGroup     PurchaseOrderGroup? @relation(fields: [purchaseOrderGroupId], references: [id], onDelete: SetNull)
  invoiceFile            JobFile?            @relation("InvoiceFile", fields: [invoiceFileId], references: [id])
  popFile                JobFile?            @relation("POPFile", fields: [proofOfPayment], references: [id])
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([lineItemId])
  @@index([purchaseOrderGroupId])
  @@index([invoiceFileId])
  @@index([proofOfPayment])
  @@map("pms_sub_costs")
}

model PurchaseOrderGroup {
  cancellationReason String?
  financeManaged Boolean @default(false)
  currency String @default("GBP")
  version Int @default(1)
  issuedAt DateTime?
  issuedBy String?
  supplierTerms String?
  documentSnapshot Json?
  documentStatus String @default("NOT_REQUESTED")
  documentError String?
  pdfJobFileId String? @unique
  pdfJobFile JobFile? @relation("FinancePoDocument", fields: [pdfJobFileId], references: [id], onDelete: Restrict)
  financeLines ProjectPurchaseOrderLine[]
  reservedCosts ProjectFinanceCost[] @relation("ActiveFinancePo")

  id                    String              @id @default(uuid())
  productionId          String
  budgetId              String?
  poNumber              String
  supplierName          String
  supplierEmail         String?
  supplierPhone         String?
  blackbookEntryId      String?
  optionCandidateId     String?
  status                PurchaseOrderStatus @default(DRAFT)
  notes                 String?
  onboardingToken       String?             @unique
  onboardingSentAt      DateTime?
  onboardingExpiresAt   DateTime?
  onboardingCompletedAt DateTime?
  sentAt                DateTime?
  acceptedAt            DateTime?
  cancelledAt           DateTime?
  allocations           SubCost[]
  production            Production          @relation(fields: [productionId], references: [id], onDelete: Cascade)
  budget                Budget?             @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  blackbookEntry        BlackbookEntry?     @relation(fields: [blackbookEntryId], references: [id], onDelete: SetNull)
  optionCandidate       OptionCandidate?    @relation(fields: [optionCandidateId], references: [id], onDelete: SetNull)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([productionId, poNumber])
  @@index([productionId, status])
  @@index([blackbookEntryId])
  @@index([optionCandidateId])
  @@map("pms_purchase_order_groups")
}

model AdvanceInvoice {
  id                 String          @id @default(uuid())
  budgetId           String
  label              String
