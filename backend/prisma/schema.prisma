generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OpportunityStatus {
  ENQUIRY
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum ProductionStatus {
  PLANNING
  CONFIRMED
  IN_PRODUCTION
  WRAP
  DELIVERED
  INVOICED
  CLOSED
}

model Settings {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("pms_settings")
}

model Opportunity {
  id          String            @id @default(cuid())
  title       String
  description String?
  status      OpportunityStatus @default(ENQUIRY)
  value       Decimal?          @db.Decimal(12, 2)
  clientName  String?
  contactId   String?
  contact     Contact?          @relation(fields: [contactId], references: [id])
  companyId   String?
  company     Company?          @relation(fields: [companyId], references: [id])
  productions Production[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("pms_opportunities")
}

model Production {
  id            String           @id @default(cuid())
  title         String
  description   String?
  status        ProductionStatus @default(PLANNING)
  opportunityId String?
  opportunity   Opportunity?     @relation(fields: [opportunityId], references: [id])
  dates         ProductionDate[]
  crewMembers   CrewMember[]
  budgets       Budget[]
  jobFiles      JobFile[]
  emailThreads  EmailThread[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("pms_productions")
}

model ProductionDate {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  label        String?
  createdAt    DateTime   @default(now())

  @@map("pms_production_dates")
}

model CrewRole {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  crewMembers CrewMember[]
  createdAt   DateTime     @default(now())

  @@map("pms_crew_roles")
}

model CrewMember {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?   @relation(fields: [contactId], references: [id])
  roleId       String?
  role         CrewRole?  @relation(fields: [roleId], references: [id])
  name         String
  email        String?
  phone        String?
  dayRate      Decimal?   @db.Decimal(10, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("pms_crew_members")
}

model Budget {
  id           String          @id @default(cuid())
  productionId String
  production   Production      @relation(fields: [productionId], references: [id], onDelete: Cascade)
  name         String
  sections     BudgetSection[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("pms_budgets")
}

model BudgetSection {
  id        String           @id @default(cuid())
  budgetId  String
  budget    Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  name      String
  order     Int              @default(0)
  lineItems BudgetLineItem[]
  createdAt DateTime         @default(now())

  @@map("pms_budget_sections")
}

model BudgetLineItem {
  id          String            @id @default(cuid())
  sectionId   String
  section     BudgetSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal           @default(1) @db.Decimal(10, 3)
  unitCost    Decimal           @default(0) @db.Decimal(12, 2)
  total       Decimal           @default(0) @db.Decimal(12, 2)
  notes       String?
  order       Int               @default(0)
  invoices    LineItemInvoice[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("pms_budget_line_items")
}

model LineItemInvoice {
  id            String         @id @default(cuid())
  lineItemId    String
  lineItem      BudgetLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  invoiceNumber String?
  amount        Decimal        @db.Decimal(12, 2)
  invoiceDate   DateTime?      @db.Date
  notes         String?
  createdAt     DateTime       @default(now())

  @@map("pms_line_item_invoices")
}

model Contact {
  id            String        @id @default(cuid())
  firstName     String
  lastName      String?
  email         String?
  phone         String?
  companyId     String?
  company       Company?      @relation(fields: [companyId], references: [id])
  jobTitle      String?
  notes         String?
  opportunities Opportunity[]
  crewMembers   CrewMember[]
  emailMessages EmailMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("pms_contacts")
}

model Company {
  id            String        @id @default(cuid())
  name          String
  website       String?
  address       String?
  notes         String?
  contacts      Contact[]
  opportunities Opportunity[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("pms_companies")
}

model JobFile {
  id           String      @id @default(cuid())
  productionId String?
  production   Production? @relation(fields: [productionId], references: [id])
  name         String
  url          String
  mimeType     String?
  size         Int?
  createdAt    DateTime    @default(now())

  @@map("pms_job_files")
}

model EmailThread {
  id            String         @id @default(cuid())
  productionId  String?
  production    Production?    @relation(fields: [productionId], references: [id])
  subject       String
  gmailThreadId String?        @unique
  messages      EmailMessage[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("pms_email_threads")
}

model EmailMessage {
  id             String      @id @default(cuid())
  threadId       String
  thread         EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  gmailMessageId String?     @unique
  from           String
  to             String?
  subject        String?
  body           String?
  htmlBody       String?
  sentAt         DateTime?
  contactId      String?
  contact        Contact?    @relation(fields: [contactId], references: [id])
  createdAt      DateTime    @default(now())

  @@map("pms_email_messages")
}
