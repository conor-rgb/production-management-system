  invoiceId String
  invoice ProjectClientInvoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amountMinor Int
  receivedAt DateTime
  reference String
  reversedAt DateTime?
  reversalReason String?
  createdAt DateTime @default(now())
  @@index([invoiceId])
  @@map("pms_project_client_receipts")
}
