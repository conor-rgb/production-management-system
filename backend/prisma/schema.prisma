  productionId String
  ledger ProjectFinanceLedger @relation(fields: [productionId], references: [productionId], onDelete: Restrict)
  supplier String
  supplierKey String
  number String
  numberKey String
  invoiceDate DateTime
  dueDate DateTime?
  netMinor Int
  taxMinor Int
  documentUrl String?
  status String @default("DRAFT")
  version Int @default(1)
  allocations ProjectInvoiceAllocation[]
  payments ProjectInvoicePayment[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([productionId, supplierKey, numberKey])
  @@index([productionId, status])
  @@unique([productionId, driveFileId])
  @@index([originalInvoiceId])
  @@map("pms_project_supplier_invoices")
}

model ProjectInvoiceAllocation {
